# QQ 机器人开放平台凭据（必填）
# 开放平台 -> 机器人 -> 开发设置 中获取
APP_ID=
CLIENT_SECRET=

# QQ 环境：production（默认，正式环境）或 sandbox（沙箱环境）
QQ_ENV=production

# 事件订阅 Intents，默认 33554432 = GROUP_AND_C2C_EVENT (1<<25)
QQ_INTENTS=33554432

# 接入点覆盖（一般留空，走 /gateway 接口自动获取）
# QQ_API_BASE=https://api.bot.qq.com
# QQ_GATEWAY_URL=wss://api.bot.qq.com/websocket/

# 日志级别：debug | info | warn | error（默认 info）
LOG_LEVEL=info

# 是否打印所有收到的 Gateway 事件（排查 @ 事件时设为 true）
LOG_EVENTS=false

# 单实例保护：默认开启。两个进程连同一机器人会导致每条消息被回复两次。
# 容器平台（Railway 等）跨部署 pid 会重复，锁已按「运行环境 + pid」双重判定；
# 若平台自身保证单副本且你确有特殊需求，可设为 false 关闭。
INSTANCE_LOCK=true

# 是否把渲染出的图片落盘到 IMAGE_OUTPUT_DIR（仅供本地排查）
# 线上建议 false，避免往容器磁盘反复写图
DEBUG_IMAGES=true

# 是否复用本地保存的 Gateway 会话做 Resume（默认 false）
# 建议保持 false：平台对已失效会话也会返回 RESUMED 但不再推送事件
SESSION_RESUME=false

# Resume 观察窗口（毫秒，仅在 SESSION_RESUME=true 时生效）
# 窗口内没有收到任何事件则判定会话失效并重新 Identify
RESUME_GRACE_MS=10000

# 行情缓存有效期（毫秒，默认 60000）
MARKET_CACHE_TTL_MS=60000

# 图片中文字体文件（留空则自动扫描系统字体，用于渲染中文行业名称）
# 多个文件用英文逗号分隔
FONT_FILES=

# 渲染出的 PNG 输出目录（默认 .tmp-probe/images）
IMAGE_OUTPUT_DIR=
